+//! Absolute output selection for a physical mode selector. Automatic preserves RMK defaults.
+use rmk_types::connection::{ConnectionStatus, ConnectionType};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum OutputSelection {
+    Off,
+    Automatic,
+    Wired,
+    Bluetooth,
+    Dongle,
+}
+
+pub(crate) fn active(status: ConnectionStatus, selection: OutputSelection) -> Option<ConnectionType> {
+    match selection {
+        OutputSelection::Off => None,
+        OutputSelection::Automatic => status.decide_active(),
+        OutputSelection::Wired => matches!(
+            status.usb,
+            rmk_types::connection::UsbState::Configured | rmk_types::connection::UsbState::Suspended
+        )
+        .then_some(ConnectionType::Usb),
+        OutputSelection::Bluetooth => (status.ble.state == rmk_types::ble::BleState::Connected
+            && (status.ble.profile as usize) < crate::NUM_BLE_PROFILE)
+            .then_some(ConnectionType::Ble),
+        OutputSelection::Dongle => {
+            #[cfg(feature = "dongle")]
+            {
+                (status.ble.state == rmk_types::ble::BleState::Connected
+                    && status.ble.profile == crate::ble::profile::DONGLE_PROFILE)
+                    .then_some(ConnectionType::Ble)
+            }
+            #[cfg(not(feature = "dongle"))]
+            {
+                None
+            }
+        }
+    }
+}
+
+/// Establish fail-closed routing before starting USB, BLE, or keyboard tasks.
+/// The input reader subsequently calls `select` to let the initialized profile manager select its peer.
+pub fn initialize(selection: OutputSelection) {
+    crate::state::set_output_selection(selection);
+}
+
+/// Use RMK's profile manager and release/routing cascade. Physical selection is not persisted:
+/// the switch supplies it on every boot, and no unavailable transport is substituted.
+#[cfg(feature = "_ble")]
+pub async fn select(selection: OutputSelection) {
+    crate::state::set_output_selection(selection);
+    use crate::ble::profile::BleProfileAction;
+    let action = match selection {
+        OutputSelection::Bluetooth => Some(BleProfileAction::SwitchLastHost),
+        #[cfg(feature = "dongle")]
+        OutputSelection::Dongle => Some(BleProfileAction::Switch(crate::ble::profile::DONGLE_PROFILE)),
+        _ => None,
+    };
+    if let Some(action) = action {
+        crate::channel::BLE_PROFILE_CHANNEL.send(action).await;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use rmk_types::{
+        ble::{BleState, BleStatus},
+        connection::UsbState,
+    };
+    fn status(usb: UsbState, ble: BleState, profile: u8) -> ConnectionStatus {
+        ConnectionStatus {
+            usb,
+            ble: BleStatus {
+                state: ble,
+                profile,
+                bonded: false,
+            },
+            preferred: ConnectionType::Usb,
+        }
+    }
+    #[test]
+    fn wired_does_not_fall_back_to_connected_radio() {
+        assert_eq!(
+            active(
+                status(UsbState::Disabled, BleState::Connected, 0),
+                OutputSelection::Wired
+            ),
+            None
+        );
+        assert_eq!(
+            active(
+                status(UsbState::Suspended, BleState::Connected, 0),
+                OutputSelection::Wired
+            ),
+            Some(ConnectionType::Usb)
+        );
+    }
+    #[test]
+    fn bluetooth_ignores_configured_usb_and_the_wrong_peer() {
+        assert_eq!(
+            active(
+                status(UsbState::Configured, BleState::Inactive, 0),
+                OutputSelection::Bluetooth
+            ),
+            None
+        );
+        assert_eq!(
+            active(
+                status(UsbState::Configured, BleState::Connected, 0),
+                OutputSelection::Bluetooth
+            ),
+            Some(ConnectionType::Ble)
+        );
+        assert_eq!(
+            active(
+                status(UsbState::Configured, BleState::Connected, crate::NUM_BLE_PROFILE as u8),
+                OutputSelection::Bluetooth
+            ),
+            None
+        );
+    }
+    #[cfg(feature = "dongle")]
+    #[test]
+    fn dongle_ignores_usb_and_host_ble_until_the_dongle_connects() {
+        assert_eq!(
+            active(
+                status(UsbState::Configured, BleState::Connected, 0),
+                OutputSelection::Dongle
+            ),
+            None
+        );
+        assert_eq!(
+            active(
+                status(
+                    UsbState::Configured,
+                    BleState::Connected,
+                    crate::ble::profile::DONGLE_PROFILE
+                ),
+                OutputSelection::Dongle
+            ),
+            Some(ConnectionType::Ble)
+        );
+    }
+}
+
+/// Clear only the dedicated dongle bond; queued profile switches cannot change its target.
+#[cfg(all(feature = "_ble", feature = "dongle"))]
+pub async fn clear_dongle_bond() {
+    crate::channel::BLE_PROFILE_CHANNEL
+        .send(crate::ble::profile::BleProfileAction::ClearSlot(
+            crate::ble::profile::DONGLE_PROFILE,
+        ))
+        .await;
+}
+
+#[cfg(all(test, feature = "_ble", feature = "dongle"))]
+#[test]
+fn dongle_clear_target_is_fixed_after_a_queued_host_switch() {
+    use crate::{
+        ble::profile::{BleProfileAction, DONGLE_PROFILE},
+        channel::BLE_PROFILE_CHANNEL,
+        test_support::test_block_on,
+    };
+    test_block_on(crate::futures::future::join(
+        async {
+            BLE_PROFILE_CHANNEL.send(BleProfileAction::SwitchLastHost).await;
+            clear_dongle_bond().await;
+        },
+        async {
+            assert!(matches!(
+                BLE_PROFILE_CHANNEL.receive().await,
+                BleProfileAction::SwitchLastHost
+            ));
+            // The host selection reaches the manager before the pending clear command.
+            crate::state::set_ble_profile(0, true);
+            assert!(
+                matches!(BLE_PROFILE_CHANNEL.receive().await, BleProfileAction::ClearSlot(slot) if slot == DONGLE_PROFILE)
+            );
+        },
+    ));
+}
